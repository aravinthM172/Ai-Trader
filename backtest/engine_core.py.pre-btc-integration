VALUE_PER_POINT = TICK_VALUE / TICK_SIZE          # = 10.0  (NOT CONTRACT_SIZE!)

MIN_LOT = 0.01
LOT_STEP = 0.01
MAX_LOT = 100.0


# ===========================================================================
