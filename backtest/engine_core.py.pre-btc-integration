# ===========================================================================
# ACCOUNT / RISK ENGINE  (exact values from realistic_xauusd.py)
# ===========================================================================
INITIAL_BALANCE = 100.0
RISK_PER_TRADE = 0.01            # 1% of realised balance risked per trade
EQUITY_STOP_FRACTION = 0.20      # stop trading if equity < 20% of start
MAX_MARGIN_FRACTION = 0.50       # never tie up more than 50% of balance
LEVERAGE = 100.0                 # assumed account leverage for the margin cap


