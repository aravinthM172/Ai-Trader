COMMISSION_PER_LOT = 0.0        # $ ; round-turn commission per lot
MIN_STOP_TICKS = 10             # broker "stops level" in ticks -> min SL distance

# derived
MIN_STOP_DIST = MIN_STOP_TICKS * TICK_SIZE            # 0.10
