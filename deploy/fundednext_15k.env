# Settings for a FundedNext Stellar 2-Step $15,000 account, TRADED AS IF IT WERE $12,000 (decided 2026-10-14).
# Not loaded by anything: merge these lines into .env on the VPS when the account is switched over.
# Needs deploy/fundednext_trader.patch applied (calm filter, position cap, reversal exit).
# Backtest (backtest/fundednext_build.py + scratchpad as8k.py, a new attempt every month since 2018-03):
#   100 % pass, 0 % fail, typically 141 days for both phases, worst drawdown about $1,130 of the $1,500 allowed;
#   with every trade 0.10R worse: 76 % pass, 0 % fail, 24 % not finished in 18 months.

# -- which firm's rules the challenge tracker follows (5 trading days per phase, 60-day inactivity) --------------
PROP_CHALLENGE=fundednext_2step
# FundedNext server clock: UTC+3 in summer (day rolls 21:00 UTC), UTC+2 in winter -> set 22 then.  Check at login.
PROP_DAY_RESET_UTC_HOUR=21

# -- markets: all five trade on their signals; GER40 dropped (FundedNext names it GER30; no edge in any study) -----
MULTI_SYMBOLS=BTCUSD,XAUUSD,NDX100,ETHUSD,USDJPY
MULTI_REGIME_SYMBOLS=XAUUSD,NDX100,USDJPY
MULTI_LONG_ONLY_SYMBOLS=NDX100,USDJPY
MULTI_STRONG_ONLY_SYMBOLS=XAUUSD,NDX100

# -- risk: 0.35 % of $12,000 = $42 per trade = 0.28 % of the real $15,000, equal on all five ------------------
MULTI_RISK_PER_TRADE=0.0028
# (no MULTI_SYMBOL_RISK line: ETHUSD and USDJPY are no longer at half)
MULTI_SYMBOL_RISK=
# smallest lot (0.01) risks about $32 on gold and $37 on NDX100: allow it, but nothing above $52
MULTI_SYMBOL_MAX_RISK=XAUUSD=0.0035,NDX100=0.0035
# at most $255 at risk across all open trades (FundedNext funded accounts allow 3 % = $450)
MULTI_MAX_TOTAL_OPEN_RISK=0.017

# -- the bot's own strict loss limits (FundedNext's are 5 % = $750 a day and 10 % = $1,500 in total) -------------
# no new trades for the rest of the day once the day's closed loss reaches $195
MULTI_DAILY_LOSS_LIMIT=0.013
# no new trades for 3 days once equity is $720 below its peak
MULTI_MAX_DRAWDOWN_PAUSE=0.048
MULTI_DD_PAUSE_HOURS=72

# -- BTC / ETH rules added on 2026-10-13/14 ----------------------------------------------------------------------
# skip a signal when the market is at least 1.2 x as volatile as its 30-day normal
MULTI_CALM_ONLY_SYMBOLS=BTCUSD,ETHUSD
MULTI_CALM_MAX_RATIO=1.2
# keep the combined BTC + ETH position value at 60 % of the account (crypto is 1:1; 70 % margin use = "gambling")
MULTI_NOTIONAL_CAP_SYMBOLS=BTCUSD,ETHUSD
MULTI_NOTIONAL_CAP=0.6
# close a trade that is 2 ATR in profit when an hourly candle of 1.5 ATR or more goes against it
MULTI_REVERSAL_EXIT_SYMBOLS=BTCUSD,ETHUSD

# -- unchanged, listed so nothing is forgotten -------------------------------------------------------------------
MULTI_NEWS_FAIL_CLOSED=true
MULTI_MAX_PER_GROUP=2
# Telegram stays unset: FundedNext prohibits bots that "incorporate" Telegram / WhatsApp (ask support first).
